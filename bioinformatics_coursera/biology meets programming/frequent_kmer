# Copy your FrequencyMap() function here.
def FrequencyMap(Text, k):
    freq={}
    n=len(Text)
    for i in range(n-k+1):
        pattern=Text[i:i+k]
        freq[pattern]=0
    for i in range(n-k+1):
        pattern=Text[i:i+k]
        freq[pattern]+=1
    return freq  
